---
layout: null
---
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Décalé³ — Bar à jeux, Fécamp</title>
<meta name="description" content="Site vitrine du bar à jeux Décalé³ à Fécamp : nouveautés, agenda des soirées et animations, carte.">
<style>
  @import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&family=Karla:wght@400;500;600;700&display=swap');

  :root{
    --bg:#f6f1e6;
    --surface:#ffffff;
    --surface-2:#efe4cd;
    --ink:#1c1712;
    --ink-soft:#5c5343;
    --accent:#c81e2c;
    --accent-ink:#fdf6ea;
    --gold:#c98a1f;
    --line:#e0d3b4;
    --shadow: 0 1px 0 rgba(28,23,18,.06);
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --bg:#141210; --surface:#1e1a15; --surface-2:#25201a; --ink:#f3ecdd;
      --ink-soft:#b9ac93; --accent:#ff5468; --accent-ink:#1a1410; --gold:#e8ab3f;
      --line:#352c21; --shadow: 0 1px 0 rgba(0,0,0,.3);
    }
  }
  *{box-sizing:border-box;}
  body{background:var(--bg);color:var(--ink);font-family:'Karla',system-ui,sans-serif;padding-inline:20px;line-height:1.5;margin:0;}
  h1,h2,h3,.display{font-family:'Baloo 2','Karla',system-ui,sans-serif;text-wrap:balance;margin:0;}
  a{color:inherit;}
  img{max-width:100%;display:block;}
  .wrap{max-width:1040px;margin-inline:auto;}

  header.nav{position:sticky;top:0;z-index:20;background:color-mix(in srgb, var(--bg) 88%, transparent);backdrop-filter:blur(8px);border-bottom:1px solid var(--line);}
  .nav-inner{max-width:1040px;margin-inline:auto;display:flex;align-items:center;justify-content:space-between;padding-block:10px;gap:16px;}
  .brand{display:flex;align-items:center;gap:10px;font-family:'Baloo 2';font-weight:800;font-size:1.05rem;}
  .brand img{width:34px;height:34px;border-radius:8px;}
  .nav-links{display:flex;gap:22px;font-size:.92rem;font-weight:600;flex-wrap:wrap;}
  .nav-links a{text-decoration:none;opacity:.82;}
  .nav-links a:hover{opacity:1;color:var(--accent);}
  .nav-cta{background:var(--accent);color:var(--accent-ink);padding:8px 14px;border-radius:999px;font-weight:700;font-size:.85rem;text-decoration:none;white-space:nowrap;}
  @media (max-width:700px){ .nav-inner{flex-direction:column;align-items:flex-start;gap:10px;padding-block:14px;} .nav-links{gap:8px 16px;} }

  .hero{display:grid;grid-template-columns:1.1fr 1fr;gap:36px;align-items:center;padding-block:44px 40px;}
  @media (max-width:760px){ .hero{grid-template-columns:1fr;padding-block:28px 24px;} }
  .eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:.78rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--accent);margin-bottom:14px;}
  .pip{width:8px;height:8px;border-radius:50%;background:var(--accent);display:inline-block;}
  .hero h1{font-size:clamp(2.1rem,5vw,3.4rem);font-weight:800;line-height:1.02;}
  .hero h1 em{font-style:normal;color:var(--accent);}
  .hero p.lede{color:var(--ink-soft);font-size:1.08rem;max-width:46ch;margin-top:14px;}
  .hero-actions{display:flex;gap:12px;margin-top:24px;flex-wrap:wrap;}
  .btn{display:inline-flex;align-items:center;gap:8px;padding:12px 20px;border-radius:12px;font-weight:700;font-size:.95rem;text-decoration:none;border:1px solid transparent;}
  .btn.primary{background:var(--accent);color:var(--accent-ink);}
  .btn.ghost{border-color:var(--line);color:var(--ink);}
  .hero-art{background:#0f0d0b;border-radius:22px;display:flex;align-items:center;justify-content:center;padding:30px;box-shadow:var(--shadow);aspect-ratio:1/1;}
  .hero-art img{width:100%;max-width:320px;}

  section{padding-block:46px;border-top:1px solid var(--line);}
  .section-head{display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin-bottom:26px;flex-wrap:wrap;}
  .section-head h2{font-size:clamp(1.5rem,3vw,2rem);font-weight:800;}
  .section-tag{font-size:.78rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--ink-soft);}

  .news-row{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
  @media (max-width:760px){ .news-row{grid-template-columns:1fr;} }
  .news-card{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:20px;box-shadow:var(--shadow);}
  .news-tag{display:inline-block;font-size:.7rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--accent-ink);background:var(--accent);padding:3px 9px;border-radius:999px;margin-bottom:12px;}
  .news-tag.soon{background:var(--gold);color:#1c1712;}
  .news-card h3{font-size:1.08rem;font-weight:700;margin-bottom:6px;}
  .news-card p{color:var(--ink-soft);font-size:.92rem;}

  .anim-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;}
  @media (max-width:900px){ .anim-grid{grid-template-columns:repeat(2,1fr);} }
  @media (max-width:520px){ .anim-grid{grid-template-columns:1fr;} }
  .anim-card{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:18px;display:flex;flex-direction:column;gap:10px;}
  .die{width:30px;height:30px;border-radius:7px;background:var(--ink);position:relative;flex-shrink:0;}
  .die i{position:absolute;width:5px;height:5px;border-radius:50%;background:var(--bg);}
  .anim-card h3{font-size:1rem;font-weight:700;}
  .anim-card p{color:var(--ink-soft);font-size:.87rem;}

  .agenda-list{display:flex;flex-direction:column;gap:12px;}
  .agenda-item{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:18px 20px;display:flex;gap:18px;align-items:flex-start;}
  @media (max-width:600px){ .agenda-item{flex-direction:column;gap:8px;} }
  .agenda-date{flex-shrink:0;width:110px;font-weight:800;font-family:'Baloo 2';color:var(--accent);font-size:.95rem;text-transform:capitalize;}
  .agenda-body h3{font-size:1.02rem;font-weight:700;margin-bottom:4px;}
  .agenda-body .type{display:inline-block;font-size:.68rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;color:var(--gold);margin-bottom:4px;}
  .agenda-body p{color:var(--ink-soft);font-size:.9rem;margin:0;}
  .agenda-empty{color:var(--ink-soft);font-size:.92rem;font-style:italic;}

  .menu-cols{display:grid;grid-template-columns:1fr 1fr;gap:36px;}
  @media (max-width:760px){ .menu-cols{grid-template-columns:1fr;gap:8px;} }
  .menu-block{margin-bottom:28px;}
  .menu-block h3{font-size:.82rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:var(--gold);margin-bottom:12px;}
  .menu-item{display:flex;align-items:baseline;gap:8px;padding-block:7px;border-bottom:1px dashed var(--line);font-size:.95rem;}
  .menu-item .name{font-weight:600;}
  .menu-item .fill{flex:1;border-bottom:1px dotted var(--line);margin-bottom:5px;}
  .menu-item .price{font-variant-numeric:tabular-nums;font-weight:700;color:var(--ink-soft);white-space:nowrap;}
  .menu-note{font-size:.82rem;color:var(--ink-soft);margin-top:10px;font-style:italic;}

  .infos{background:#0f0d0b;color:#f3ecdd;border-radius:24px;padding:38px clamp(20px,4vw,44px);display:grid;grid-template-columns:1.2fr 1fr;gap:32px;}
  @media (max-width:760px){ .infos{grid-template-columns:1fr;} }
  .infos h2{color:#fff;font-size:1.6rem;font-weight:800;margin-bottom:6px;}
  .infos .sub{color:#c8bda3;margin-bottom:22px;font-size:.95rem;}
  .info-line{display:flex;gap:12px;padding-block:10px;border-bottom:1px solid rgba(255,255,255,.1);font-size:.94rem;}
  .info-line:last-child{border-bottom:none;}
  .info-line .k{width:96px;flex-shrink:0;color:#c8bda3;font-weight:700;font-size:.78rem;text-transform:uppercase;letter-spacing:.06em;padding-top:2px;}
  .info-line a{color:#fff;text-decoration:underline;text-decoration-color:var(--accent);text-underline-offset:3px;}
  .hours-table{width:100%;border-collapse:collapse;font-size:.94rem;}
  .hours-table td{padding-block:9px;border-bottom:1px solid rgba(255,255,255,.1);}
  .hours-table td:last-child{text-align:right;font-variant-numeric:tabular-nums;color:#fff;font-weight:600;}
  .map-btn{display:inline-flex;margin-top:18px;background:var(--accent);color:var(--accent-ink);padding:11px 18px;border-radius:12px;font-weight:700;font-size:.9rem;text-decoration:none;}

  footer{padding-block:30px 40px;text-align:center;color:var(--ink-soft);font-size:.82rem;}
  footer strong{color:var(--ink);}
</style>
</head>
<body>

<header class="nav">
  <div class="nav-inner">
    <div class="brand"><img src="data:image/jpeg;base64," alt="Logo Décalé³"> Décalé³</div>
    <nav class="nav-links">
      <a href="#nouveautes">Nouveautés</a>
      <a href="#agenda">Agenda</a>
      <a href="#animations">Animations</a>
      <a href="#carte">La carte</a>
      <a href="#infos">Infos pratiques</a>
    </nav>
    <a class="nav-cta" href="tel:+33951639570">09 51 63 95 70</a>
  </div>
</header>

<main class="wrap">
  <section class="hero" style="border-top:none;padding-top:36px;">
    <div>
      <div class="eyebrow"><span class="pip"></span> Bar à jeux · Fécamp</div>
      <h1>On y joue,<br>on y <em>traîne</em>,<br>on y revient.</h1>
      <p class="lede">Décalé³ est le café ludique de Fécamp : une ludothèque à disposition, des sirops maison, et un agenda régulier pour qu'on ait toujours une bonne raison de repasser dans la semaine.</p>
      <div class="hero-actions">
        <a class="btn primary" href="#agenda">Voir l'agenda</a>
        <a class="btn ghost" href="#infos">Adresse &amp; horaires</a>
      </div>
    </div>
    <div class="hero-art"><img src="data:image/jpeg;base64," alt="Décalé³ — Fécamp"></div>
  </section>

  <section id="nouveautes">
    <div class="section-head">
      <h2>Quoi de neuf</h2>
      <span class="section-tag">Dernières nouvelles du comptoir</span>
    </div>
    <div class="news-row">
      {% for item in collections.nouveautes %}
      <div class="news-card">
        <span class="news-tag{% if item.data.tag == 'bientot' %} soon{% endif %}">{% if item.data.tag == 'bientot' %}Bientôt{% else %}Nouveau{% endif %}</span>
        <h3>{{ item.data.title }}</h3>
        <p>{{ item.data.description }}</p>
      </div>
      {% else %}
      <p class="agenda-empty">Rien de neuf pour l'instant.</p>
      {% endfor %}
    </div>
  </section>

  <section id="agenda">
    <div class="section-head">
      <h2>Agenda</h2>
      <span class="section-tag">Les prochains rendez-vous</span>
    </div>
    <div class="agenda-list">
      {% set typeLabels = {"theme": "Soirée à thème", "magic": "Magic: The Gathering", "quiz": "Quiz night", "decouverte": "Découverte hebdo"} %}
      {% for item in collections.agenda %}
      <div class="agenda-item">
        <div class="agenda-date">{{ item.data.date | dateFr }}</div>
        <div class="agenda-body">
          <span class="type">{{ typeLabels[item.data.type] or item.data.type }}</span>
          <h3>{{ item.data.title }}</h3>
          <p>{{ item.data.description }}</p>
        </div>
      </div>
      {% else %}
      <p class="agenda-empty">Agenda en cours de remplissage — revenez bientôt.</p>
      {% endfor %}
    </div>
  </section>

  <section id="animations">
    <div class="section-head">
      <h2>Nos rendez-vous réguliers</h2>
      <span class="section-tag">Le programme type</span>
    </div>
    <div class="anim-grid">
      <div class="anim-card">
        <div class="die"><i style="top:22%;left:22%"></i><i style="top:22%;right:22%;left:auto"></i><i style="bottom:22%;left:22%"></i><i style="bottom:22%;right:22%;left:auto"></i></div>
        <h3>Soirées à thème</h3>
        <p>Une thématique différente pour explorer la ludothèque sous un nouvel angle.</p>
      </div>
      <div class="anim-card">
        <div class="die"><i style="top:22%;left:22%"></i><i style="bottom:22%;right:22%;left:auto"></i><i style="top:50%;left:50%;transform:translate(-50%,-50%)"></i></div>
        <h3>Magic: The Gathering</h3>
        <p>Tables Commander ouvertes à tous les niveaux, dans une ambiance décontractée.</p>
      </div>
      <div class="anim-card">
        <div class="die"><i style="top:50%;left:22%;transform:translateY(-50%)"></i><i style="top:50%;right:22%;left:auto;transform:translateY(-50%)"></i></div>
        <h3>Quiz nights</h3>
        <p>Soirée quiz en équipes, ambiance conviviale et petits lots à la clé.</p>
      </div>
      <div class="anim-card">
        <div class="die"><i style="top:50%;left:50%;transform:translate(-50%,-50%)"></i></div>
        <h3>Découverte hebdo</h3>
        <p>Chaque semaine, un jeu présenté et expliqué par l'équipe pour le tester en toute simplicité.</p>
      </div>
    </div>
    <p class="menu-note">Dates précises dans l'agenda ci-dessus — réservation conseillée pour les tables Magic. Contactez-nous au <a href="tel:+33951639570" style="color:var(--accent);font-weight:700;">09 51 63 95 70</a>.</p>
  </section>

  <section id="carte">
    <div class="section-head">
      <h2>La carte</h2>
      <span class="section-tag">Prix indicatifs — carte complète sur place</span>
    </div>
    <div class="menu-cols">
      <div>
        <div class="menu-block">
          <h3>Sirops maison</h3>
          <div class="menu-item"><span class="name">Bubble gum</span><span class="fill"></span><span class="price">dès 2,50 €</span></div>
          <div class="menu-item"><span class="name">Barbe à papa</span><span class="fill"></span><span class="price">dès 2,50 €</span></div>
          <div class="menu-item"><span class="name">Pop-corn</span><span class="fill"></span><span class="price">dès 2,50 €</span></div>
          <div class="menu-item"><span class="name">Abricot</span><span class="fill"></span><span class="price">dès 2,50 €</span></div>
        </div>
        <div class="menu-block">
          <h3>Cocktails</h3>
          <div class="menu-item"><span class="name">Cocktails signature</span><span class="fill"></span><span class="price">dès 6 €</span></div>
          <div class="menu-item"><span class="name">Bières &amp; vins</span><span class="fill"></span><span class="price">dès 3,50 €</span></div>
        </div>
      </div>
      <div>
        <div class="menu-block">
          <h3>À grignoter</h3>
          <div class="menu-item"><span class="name">Salé</span><span class="fill"></span><span class="price">dès 4 €</span></div>
          <div class="menu-item"><span class="name">Sucré</span><span class="fill"></span><span class="price">dès 3 €</span></div>
        </div>
        <div class="menu-block">
          <h3>Softs &amp; boissons chaudes</h3>
          <div class="menu-item"><span class="name">Softs</span><span class="fill"></span><span class="price">dès 2 €</span></div>
          <div class="menu-item"><span class="name">Café, thé, chocolat chaud</span><span class="fill"></span><span class="price">dès 2 €</span></div>
        </div>
      </div>
    </div>
    <p class="menu-note">Tarifs à confirmer — affichés à titre indicatif en attendant la carte définitive.</p>
  </section>

  <section id="infos" style="border-top:none;">
    <div class="infos">
      <div>
        <h2>Nous trouver</h2>
        <p class="sub">Au cœur de Fécamp, entre une partie de Magic et un sirop maison.</p>
        <div class="info-line"><span class="k">Adresse</span><span>7 rue Jacques Huet<br>76400 Fécamp</span></div>
        <div class="info-line"><span class="k">Téléphone</span><span><a href="tel:+33951639570">09 51 63 95 70</a></span></div>
        <a class="map-btn" href="https://www.google.com/maps/search/?api=1&query=7+rue+Jacques+Huet+76400+F%C3%A9camp" target="_blank" rel="noopener">Itinéraire →</a>
      </div>
      <div>
        <h2 style="font-size:1.1rem;margin-bottom:14px;">Horaires</h2>
        <table class="hours-table">
          <tr><td>Mardi — Jeudi</td><td>10h30 – 20h00</td></tr>
          <tr><td>Vendredi — Samedi</td><td>10h30 – minuit</td></tr>
          <tr><td>Dimanche — Lundi</td><td>À confirmer</td></tr>
        </table>
      </div>
    </div>
  </section>
</main>

<footer>
  <strong>Décalé³</strong> — 7 rue Jacques Huet, 76400 Fécamp
</footer>

<script>
  if (window.netlifyIdentity) {
    window.netlifyIdentity.on("init", (user) => {
      if (!user) {
        window.netlifyIdentity.on("login", () => { document.location.href = "/admin/"; });
      }
    });
  }
</script>
<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</body>
</html>
